# ── Supabase (인증 + DB) ────────────────────────────────────────────────
# 미설정 시 앱은 localStorage 모드로 동작합니다 (계정 발급 전에도 전체 시연 가능)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── 온통청년 청년정책 API ───────────────────────────────────────────────
# 발급: youthcenter.go.kr 회원가입 → 마이페이지 > OPEN API → 신청 (담당자 심사 후 승인)
YOUTH_API_KEY=

# ── Claude API (목표 파싱 · 결과 설명) ──────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 정책 정형 DB 기준일 (화면 표기용)
POLICY_DB_BASED_ON=2026-09-03
